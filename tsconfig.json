{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2020", "DOM"],
    "types": [],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
